CREATE TABLE bronze.raw_blood_inventory AS 
SELECT *, CURRENT_TIMESTAMP AS ingested_at
FROM read_csv_auto('INDIA_blood_inventory_async.csv');


select count(*) as total_rows
from bronze.raw_blood_inventory
;


select state, count(distinct hospitalcode) as banks
from bronze.raw_blood_inventory
group by state
order by banks desc
limit 5
;


DESCRIBE bronze.raw_blood_inventory;


DROP TABLE bronze.raw_blood_inventory;


select *
from read_csv_auto('INDIA_blood_inventory_async.csv')
limit 1
;


CREATE TABLE bronze.raw_blood_inventory AS
SELECT *, CURRENT_TIMESTAMP AS ingested_at
FROM read_csv(
    'INDIA_blood_inventory_async.csv',
    header = True,
    delim = ',',
    quote = '"',
    escape = '"',
    auto_detect = True,
    ignore_errors = True,
    null_padding = True
);


select count(*)
from bronze.raw_blood_inventory
;



SELECT "hospitalname" ,
"hospitalType" ,
"State",
"District"
FROM bronze.raw_blood_inventory
LIMIT 5
;



