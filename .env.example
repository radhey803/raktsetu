# ==============================================================================
# BloodGrid Environment Configuration (.env.example)
# Copy this file to .env and configure local values.
# NOTE: config.py reads unprefixed names (e.g. SCRAPER_CONCURRENCY); most BLOODGRID_* keys
# below are placeholders for future features. See docs/guide/02_INSTALLATION.md.
# NEVER commit .env with real credentials to git!
# ==============================================================================

# Application Environment
BLOODGRID_ENV=development
BLOODGRID_LOG_LEVEL=INFO
BLOODGRID_HOST=0.0.0.0
BLOODGRID_PORT=8000
BLOODGRID_ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","https://bloodgrid.in"]

# Database Paths
BLOODGRID_WAREHOUSE_PATH=blood_warehouse.duckdb
BLOODGRID_SERVING_PATH=serving.duckdb
BLOODGRID_LANDING_DIR=data/landing
BLOODGRID_POSTGRES_URL=

# Scraper Polite Ingestion Parameters
BLOODGRID_SCRAPER_USER_AGENT=BloodGrid-DataCollector/1.0 (+https://bloodgrid.in; data@bloodgrid.in)
BLOODGRID_SCRAPER_CONCURRENCY=10
BLOODGRID_SCRAPER_TIMEOUT_SEC=15
BLOODGRID_SCRAPER_MAX_RETRIES=3
BLOODGRID_MIN_RUN_INTERVAL_HOURS=3.0
BLOODGRID_CIRCUIT_BREAKER_MAX_ERROR_PCT=20.0

# Map Tiles & Geocoding
BLOODGRID_CARTO_API_KEY=
BLOODGRID_NOMINATIM_USER_AGENT=BloodGrid-Geocoder/1.0 (geocoding@bloodgrid.in)

# Authentication & Security
BLOODGRID_JWT_SECRET=
BLOODGRID_JWT_ALGORITHM=HS256
BLOODGRID_JWT_EXPIRE_MINUTES=1440
BLOODGRID_API_KEY_SECRET=

# Rate Limiting
BLOODGRID_RATE_LIMIT_PUBLIC=60/minute
BLOODGRID_RATE_LIMIT_PRO=300/minute
BLOODGRID_RATE_LIMIT_ENTERPRISE=1200/minute

# Alerting Channels (Optional / Placeholders)
BLOODGRID_TELEGRAM_BOT_TOKEN=
BLOODGRID_TELEGRAM_CHAT_ID=
BLOODGRID_SMTP_HOST=smtp.sendgrid.net
BLOODGRID_SMTP_PORT=587
BLOODGRID_SMTP_USER=apikey
BLOODGRID_SMTP_PASSWORD=
BLOODGRID_ALERT_FROM_EMAIL=alerts@bloodgrid.in

# Payment Gateway (Razorpay Test Mode)
BLOODGRID_RAZORPAY_KEY_ID=
BLOODGRID_RAZORPAY_KEY_SECRET=
BLOODGRID_RAZORPAY_WEBHOOK_SECRET=

# Object Storage / S3 / Cloudflare R2 Backups
BLOODGRID_S3_ENDPOINT_URL=
BLOODGRID_S3_ACCESS_KEY_ID=
BLOODGRID_S3_SECRET_ACCESS_KEY=
BLOODGRID_S3_BUCKET_NAME=bloodgrid-warehouse-backups
